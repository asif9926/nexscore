{
  "rules": {
    "matches": {
      ".read": true,
      "$matchId": {
        ".write": "auth != null && (!data.exists() || data.child('meta/createdBy').val() === auth.uid)"
      }
    },
    "admin_active_matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "match_actionLogs": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}