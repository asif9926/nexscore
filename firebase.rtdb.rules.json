{
  "rules": {
    "matches": {
      ".read": true,
      ".indexOn": ["meta/status", "meta/createdBy"],
      "$matchId": {
        ".write": "auth != null && ((!data.exists() && newData.child('meta/createdBy').val() === auth.uid) || (data.exists() && data.child('meta/createdBy').val() === auth.uid && (!newData.exists() || newData.child('meta/createdBy').val() === auth.uid)))",
        "meta": {
          ".validate": "newData.hasChildren(['teamA', 'teamB', 'sport'])"
        }
      }
    },
    "admin_active_matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "match_actionLogs": {
      "$matchId": {
        ".read": "auth != null && root.child('matches').child($matchId).child('meta/createdBy').val() === auth.uid",
        ".write": "auth != null && ((root.child('matches').child($matchId).child('meta/createdBy').val() === auth.uid) || (!root.child('matches').child($matchId).exists() && auth != null))"
      }
    }
  }
}